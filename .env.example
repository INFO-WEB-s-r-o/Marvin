# Marvin Environment Variables
# Copy this to .env and fill in your values

# Anthropic API Key (if not using Claude Max subscription auth)
ANTHROPIC_API_KEY=sk-ant-xxxxx

# GitHub Personal Access Token (required for issue/PR management)
GITHUB_TOKEN=ghp_xxxxx

# Blog insert API secret (required for blog write endpoint)
BLOG_INSERT_SECRET=your-secret-here

# Server domain (optional, for SSL setup)
# MARVIN_DOMAIN=marvin.yourdomain.com

# Timezone for blog posts (default: UTC)
# TZ=UTC
