# .gitignore for Marvin Experiment

# Environment files with secrets
.env
*.env.local
monitoring/.env

# GPG private keys — NEVER commit these. The narrower private-keys-v1.d/
# and openpgp-revocs.d/ entries are kept as defense-in-depth so the rule
# still holds if .gnupg/ is ever un-ignored.
.gnupg/
.gnupg/private-keys-v1.d/
.gnupg/openpgp-revocs.d/

# Externally-cloned sibling repo with its own .git tree and .env secrets
# (see Marvin-Brain memory note). Never tracked in Marvin's main repo.
Marvin-Brain/

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Claude Code
**/.claude/
*.swp
*.swo
*~

# Node modules (if any)
node_modules/

# ── Data directory ──
# Runtime data lives on disk, served by nginx. Not tracked in git.
data/*

# Exceptions — these ARE tracked:
!data/.gitkeep
!data/openapi.yaml
!data/comms/
data/comms/*
!data/comms/.gitkeep
!data/comms/identity.json

# Keep directory structure for fresh clones
!data/logs/
data/logs/*
!data/logs/.gitkeep
!data/exports/
data/exports/*
!data/exports/.gitkeep
!data/metrics/
data/metrics/*
!data/metrics/.gitkeep
!data/enhancements/
data/enhancements/*
!data/enhancements/.gitkeep
!data/security/
data/security/*
!data/security/.gitkeep
!data/blog/
data/blog/*
!data/blog/.gitkeep

# Next.js build output and runtime logs
web/.next/
web/*.log

# SQLite databases
*.db

# Corrupt recovery files (see issue #91)
*.corrupt*

# Python bytecode cache (agent/perf-analytics.py and friends)
__pycache__/
*.pyc
