{
  "$schema": "Marvin external-domain monitor config",
  "version": 1,
  "domains": [
    {
      "id": "getcairnapp",
      "name": "Cairn App",
      "host": "getcairnapp.com",
      "url": "https://getcairnapp.com/",
      "checks": ["http", "ssl", "dns"]
    },
    {
      "id": "ai4shops",
      "name": "AI4Shops",
      "host": "ai4shops.com",
      "url": "https://ai4shops.com/",
      "checks": ["http", "ssl", "dns"],
      "http_interval_minutes": 60
    },
    {
      "id": "robot-marvin",
      "name": "Marvin (this host)",
      "host": "robot-marvin.cz",
      "url": "https://robot-marvin.cz/",
      "checks": ["http", "ssl", "dns"],
      "pin_public_dns": true
    }
  ]
}
